{
  "name": "evolve",
  "version": "0.1.0",
  "description": "Система эволюции знания для кодинг-агента (ТЗ: knowledge-evolution-tz.md v0.3)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "evolve": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evolve": "node dist/cli.js"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
